declare_args() {
  enable_desktop_capturer = true

  # Allow running Electron as a node binary.
  enable_run_as_node = true

  enable_osr = true

  enable_views_api = true

  enable_pdf_viewer = true

  enable_tts = true

  enable_color_chooser = true

  enable_picture_in_picture = true

  # Provide a fake location provider for mocking
  # the geolocation responses. Disable it if you
  # need to test with chromium's location provider.
  # Should not be enabled for release build.
  enable_fake_location_provider = !is_official_build

  # Enable Chrome extensions support.
  enable_electron_extensions = true

  # Enable Spellchecker support
  enable_builtin_spellchecker = true

  # Link only the Chrome common sources used by Electron. This stays disabled
  # by default so upstream Electron build profiles keep their existing graph.
  enable_electron_slim_chrome_common = false

  # Package only the Chrome resources that Electron's WebUI and extension
  # integration consume. Keep this opt-in so default Electron builds retain
  # Chromium's complete resource set.
  enable_electron_slim_chrome_resources = false

  # Build EASR v2 archives and install their key provider in every Electron
  # process. This is deliberately opt-in: false keeps ordinary ASAR packaging
  # and ordinary-ASAR runtime behavior fully compatible.
  enable_easar_v2 = false

  # Trusted build inputs. Key material is read from these files and is never
  # accepted as a GN value or command-line byte string. The signing private key
  # is used only by the pack action; only the data key and verification public
  # key are emitted into the runtime key header.
  easar_v2_data_key_file = ""
  easar_v2_signing_private_key_file = ""
  easar_v2_signing_public_key_file = ""

  # Pure Node build actions cannot validate Windows ACLs. Windows production
  # builds must explicitly acknowledge that the configured key files are
  # protected by the CI/host ACL boundary.
  easar_v2_trust_windows_key_acl = false

  # Decimal uint64 rollback epoch. It is a string so all uint64 values remain
  # exact in GN and JavaScript.
  easar_v2_epoch = ""

  # Reject ordinary ASAR only when both this and enable_easar_v2 are true.
  easar_v2_require_encrypted = false

  # 64 KiB chunks balance compact 16-byte tags with range-read granularity.
  easar_v2_block_size_log2 = 16

  # Maximum DEFLATE effort minimizes shipped bytes; decompression remains the
  # same bounded per-chunk operation on the runtime hot path.
  easar_v2_compression_level = 9
  easar_v2_enable_compression = true
}

assert(!enable_electron_slim_chrome_resources ||
           enable_electron_slim_chrome_common,
       "Slim Chrome resources require enable_electron_slim_chrome_common")
assert(!enable_electron_slim_chrome_resources || !enable_pdf_viewer,
       "Slim Chrome resources do not include PDF viewer resources")

assert(!easar_v2_require_encrypted || enable_easar_v2,
       "easar_v2_require_encrypted requires enable_easar_v2")
assert(!enable_easar_v2 || easar_v2_data_key_file != "",
       "enable_easar_v2 requires easar_v2_data_key_file")
assert(!enable_easar_v2 || easar_v2_signing_private_key_file != "",
       "enable_easar_v2 requires easar_v2_signing_private_key_file")
assert(!enable_easar_v2 || easar_v2_signing_public_key_file != "",
       "enable_easar_v2 requires easar_v2_signing_public_key_file")
assert(!enable_easar_v2 || easar_v2_epoch != "",
       "enable_easar_v2 requires an explicit easar_v2_epoch")
assert(!enable_easar_v2 || host_os != "win" || easar_v2_trust_windows_key_acl,
       "Windows EASR builds require easar_v2_trust_windows_key_acl=true")
assert(easar_v2_block_size_log2 >= 12 && easar_v2_block_size_log2 <= 20,
       "easar_v2_block_size_log2 must be between 12 and 20")
assert(easar_v2_compression_level >= 1 && easar_v2_compression_level <= 9,
       "easar_v2_compression_level must be between 1 and 9")
